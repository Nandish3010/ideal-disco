# Firebase web app config as a single-line JSON string (Firebase console > Project settings > Your apps)
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"green-corridor-2026","appId":"..."}
# Cloud Run corridor-api base URL (optional; defaults to the deployed service)
VITE_API_BASE=https://corridor-api-919512130399.asia-south1.run.app
# Maps JS browser key (optional; Maps is not loaded yet)
VITE_MAPS_BROWSER_KEY=
# Web push key for cops' phones (Firebase console > Project settings > Cloud Messaging > Web Push certificates > Generate key pair).
# Optional: without it going on duty works, no push notification is requested.
VITE_FIREBASE_VAPID_KEY=
