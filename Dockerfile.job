# build from repo root: docker build -f Dockerfile.job .
# python:3.12-slim (3.12.13), multi-arch index digest, same pin as api/Dockerfile
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY jobs/requirements.txt jobs/requirements.txt
RUN pip install -r jobs/requirements.txt
COPY api/leadtime.py api/leadtime.py
COPY jobs jobs
COPY data/corridors data/corridors
RUN useradd --system --uid 10001 --no-create-home app
USER 10001
CMD ["python", "jobs/traffic_logger.py"]
