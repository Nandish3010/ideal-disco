# build from repo root: docker build -f Dockerfile.job .
FROM python:3.12-slim
WORKDIR /app
COPY jobs/requirements.txt jobs/requirements.txt
RUN pip install --no-cache-dir -r jobs/requirements.txt
COPY api/leadtime.py api/leadtime.py
COPY jobs jobs
COPY data/corridors data/corridors
CMD ["python", "jobs/traffic_logger.py"]
