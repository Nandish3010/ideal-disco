{
  "displayName": "Green Corridor - corridor-api",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Requests per second by status class (corridor-api)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"corridor-api\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": [
                      "metric.label.\"response_code_class\""
                    ]
                  }
                }
              },
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "60s",
              "legendTemplate": "${metric.labels.response_code_class}"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "Request latency p50 and p95 (ms)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"corridor-api\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_PERCENTILE_50"
                  }
                }
              },
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "legendTemplate": "p50"
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"corridor-api\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_PERCENTILE_95"
                  }
                }
              },
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "legendTemplate": "p95"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "5xx rate (share of requests)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilterRatio": {
                  "numerator": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"corridor-api\" metric.label.\"response_code_class\"=\"5xx\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  },
                  "denominator": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"corridor-api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              },
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "legendTemplate": "5xx share"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "thresholds": [
            {
              "value": 0.02,
              "label": "2% alert threshold"
            }
          ]
        }
      },
      {
        "title": "Container instances",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"corridor-api\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": [
                      "metric.label.\"state\""
                    ]
                  }
                }
              },
              "plotType": "STACKED_AREA",
              "minAlignmentPeriod": "60s",
              "legendTemplate": "${metric.labels.state}"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "Traffic logger job executions",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/job/completed_execution_count\" resource.type=\"cloud_run_job\" resource.label.\"job_name\"=\"corridor-traffic-logger\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": [
                      "metric.label.\"result\""
                    ]
                  }
                }
              },
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "60s",
              "legendTemplate": "${metric.labels.result}"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "Alerts fired (PREPARE, UPDATE, STOP)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/alert_fired\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_SUM",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                }
              },
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "300s"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "Escalations (no ACK in 20 s)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/escalation\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_SUM",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                }
              },
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "300s"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "Sequencing sentence fell back to the template",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/rationale_template\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_SUM",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                }
              },
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "300s"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "Hospital brief failures",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/brief_error\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_SUM",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                }
              },
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "300s"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          },
          "timeshiftDuration": "0s"
        }
      }
    ]
  }
}
